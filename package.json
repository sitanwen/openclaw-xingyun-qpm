{
  "name": "openclaw-xingyun-qpm",
  "version": "0.1.0",
  "description": "OpenClaw provider plugin that queues Xingyun model calls under a rolling QPM limit without interrupting agent runs.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "openclaw.plugin.json", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --import tsx test/*.test.ts",
    "check": "npm run build && npm test"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openclaw": "2026.6.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "providers": ["xingyun-qpm"],
    "compat": {
      "pluginApi": ">=2026.6.1",
      "minGatewayVersion": "2026.6.1"
    },
    "build": {
      "openclawVersion": "2026.6.1",
      "pluginSdkVersion": "2026.6.1"
    }
  }
}
